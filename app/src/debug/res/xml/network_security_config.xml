<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds allow local HTTP development servers (e.g. http://<lan-ip>:3003) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
